            </item>
            <item>
             <widget class="QPushButton" name="buttonBrowseGitKey">
              <property name="text">
               <string>Browse...</string>
              </property>
             </widget>
            </item>
           </layout>
          </item>
          <item row="6" column="0">
           <widget class="QLabel" name="labelGitAuthorName">
            <property name="text">
             <string>Author Name (optional):</string>
            </property>
           </widget>
          </item>
          <item row="6" column="1">
           <widget class="QLineEdit" name="editGitAuthorName">
            <property name="placeholderText">
             <string>KeePassXC Sync</string>
            </property>
           </widget>
          </item>
          <item row="7" column="0">
           <widget class="QLabel" name="labelGitAuthorEmail">
            <property name="text">
             <string>Author Email (optional):</string>
            </property>
           </widget>
          </item>
          <item row="7" column="1">
           <widget class="QLineEdit" name="editGitAuthorEmail">
