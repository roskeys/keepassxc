             <string>keepassxc@example.com</string>
            </property>
           </widget>
          </item>
         </layout>
        </widget>
       </item>
       <item>
        <layout class="QHBoxLayout" name="layoutTestGit">
         <item>
          <widget class="QPushButton" name="buttonTestGit">
           <property name="text">
            <string>Test Git Connection</string>
           </property>
