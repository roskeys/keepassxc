     <!-- Tab 4: Git -->
     <widget class="QWidget" name="tabGit">
      <attribute name="title">
       <string>Git</string>
      </attribute>
      <layout class="QVBoxLayout" name="verticalLayoutGit">
       <item>
        <widget class="QCheckBox" name="checkGitEnabled">
         <property name="text">
          <string>Enable Git Repository Synchronization</string>
         </property>
        </widget>
       </item>
       <item>
        <widget class="QGroupBox" name="groupGitSettings">
         <property name="title">
          <string>Git Configuration</string>
         </property>
         <layout class="QFormLayout" name="formLayoutGit">
          <item row="0" column="0">
           <widget class="QLabel" name="labelGitRepoUrl">
            <property name="text">
             <string>Repository URL:</string>
            </property>
           </widget>
          </item>
          <item row="0" column="1">
           <widget class="QLineEdit" name="editGitRepoUrl">
            <property name="placeholderText">
             <string>git@example.com:user/passwords.git or https://example.com/user/passwords.git</string>
            </property>
           </widget>
          </item>
          <item row="1" column="0">
           <widget class="QLabel" name="labelGitBranch">
            <property name="text">
             <string>Branch:</string>
            </property>
           </widget>
          </item>
          <item row="1" column="1">
           <widget class="QLineEdit" name="editGitBranch">
