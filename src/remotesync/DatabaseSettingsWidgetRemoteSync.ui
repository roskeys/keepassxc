             <string>main</string>
            </property>
           </widget>
          </item>
          <item row="2" column="0">
           <widget class="QLabel" name="labelGitRemotePath">
            <property name="text">
             <string>File Path in Repo:</string>
            </property>
           </widget>
          </item>
          <item row="2" column="1">
           <widget class="QLineEdit" name="editGitRemotePath">
            <property name="placeholderText">
             <string>passwords.kdbx</string>
