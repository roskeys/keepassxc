           </widget>
          </item>
          <item row="3" column="0">
           <widget class="QLabel" name="labelGitUsername">
            <property name="text">
             <string>Username (HTTPS):</string>
            </property>
           </widget>
          </item>
          <item row="3" column="1">
           <widget class="QLineEdit" name="editGitUsername">
            <property name="placeholderText">
             <string>username (e.g., roskeys or personal access token)</string>
            </property>
           </widget>
          </item>
          <item row="4" column="0">
           <widget class="QLabel" name="labelGitPassword">
            <property name="text">
             <string>Password / Token / Passphrase:</string>
            </property>
           </widget>
          </item>
          <item row="4" column="1">
           <widget class="QLineEdit" name="editGitPassword">
            <property name="echoMode">
             <enum>QLineEdit::Password</enum>
            </property>
           </widget>
          </item>
          <item row="5" column="0">
           <widget class="QLabel" name="labelGitKeyPath">
            <property name="text">
             <string>SSH Private Key (optional):</string>
            </property>
           </widget>
          </item>
          <item row="5" column="1">
           <layout class="QHBoxLayout" name="layoutGitKeyPath">
            <item>
             <widget class="QLineEdit" name="editGitKeyPath">
              <property name="placeholderText">
               <string>~/.ssh/id_ed25519 (leave blank for default)</string>
              </property>
