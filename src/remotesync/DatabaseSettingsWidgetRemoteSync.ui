            <string/>
           </property>
          </widget>
         </item>
        </layout>
       </item>
       <item>
        <spacer name="verticalSpacerGit">
         <property name="orientation">
          <enum>Qt::Vertical</enum>
         </property>
         <property name="sizeHint" stdset="0">
          <size>
           <width>20</width>
           <height>40</height>
          </size>
         </property>
        </spacer>
       </item>
      </layout>
     </widget>
    </widget>
   </item>

   <!-- Global Settings -->
   <item>
    <widget class="QGroupBox" name="groupGlobalSettings">
     <property name="title">
      <string>General Sync Settings</string>
     </property>
     <layout class="QFormLayout" name="formLayoutGlobal">
      <item row="0" column="0">
       <widget class="QLabel" name="labelInterval">
