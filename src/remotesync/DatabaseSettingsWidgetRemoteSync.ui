           <widget class="QLabel" name="labelWebDavPassword">
            <property name="text">
             <string>Password / Token:</string>
            </property>
           </widget>
          </item>
          <item row="3" column="1">
           <widget class="QLineEdit" name="editWebDavPassword">
            <property name="echoMode">
