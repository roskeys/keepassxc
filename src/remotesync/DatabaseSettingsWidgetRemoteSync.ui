     <!-- Tab 3: SFTP (SSH) -->
     <widget class="QWidget" name="tabSftp">
      <attribute name="title">
       <string>SFTP (SSH)</string>
      </attribute>
      <layout class="QVBoxLayout" name="verticalLayoutSftp">
       <item>
        <widget class="QCheckBox" name="checkSftpEnabled">
         <property name="text">
          <string>Enable SFTP Synchronization</string>
         </property>
        </widget>
       </item>
       <item>
        <widget class="QGroupBox" name="groupSftpSettings">
         <property name="title">
          <string>SFTP Configuration</string>
         </property>
         <layout class="QFormLayout" name="formLayoutSftp">
          <item row="0" column="0">
           <widget class="QLabel" name="labelSftpHost">
            <property name="text">
             <string>Host / Server IP:</string>
            </property>
           </widget>
          </item>
          <item row="0" column="1">
           <widget class="QLineEdit" name="editSftpHost">
            <property name="placeholderText">
             <string>sftp.example.com or user@example.com</string>
            </property>
           </widget>
          </item>
          <item row="1" column="0">
           <widget class="QLabel" name="labelSftpPort">
            <property name="text">
             <string>Port:</string>
            </property>
           </widget>
          </item>
          <item row="1" column="1">
           <widget class="QSpinBox" name="spinSftpPort">
            <property name="minimum">
             <number>1</number>
            </property>
            <property name="maximum">
             <number>65535</number>
            </property>
            <property name="value">
             <number>22</number>
            </property>
           </widget>
          </item>
          <item row="2" column="0">
           <widget class="QLabel" name="labelSftpRemotePath">
            <property name="text">
             <string>Remote File Path:</string>
            </property>
           </widget>
          </item>
          <item row="2" column="1">
           <widget class="QLineEdit" name="editSftpRemotePath">
            <property name="placeholderText">
             <string>/home/user/Passwords.kdbx</string>
            </property>
           </widget>
          </item>
          <item row="3" column="0">
           <widget class="QLabel" name="labelSftpUsername">
            <property name="text">
             <string>Username:</string>
            </property>
           </widget>
          </item>
          <item row="3" column="1">
           <widget class="QLineEdit" name="editSftpUsername">
            <property name="placeholderText">
             <string>user</string>
            </property>
           </widget>
          </item>
          <item row="4" column="0">
           <widget class="QLabel" name="labelSftpKeyPath">
            <property name="text">
             <string>Private Key Path:</string>
            </property>
           </widget>
          </item>
          <item row="4" column="1">
           <layout class="QHBoxLayout" name="layoutKeyPath">
            <item>
             <widget class="QLineEdit" name="editSftpKeyPath">
              <property name="placeholderText">
               <string>~/.ssh/id_ed25519 (leave blank for default)</string>
              </property>
             </widget>
            </item>
            <item>
             <widget class="QPushButton" name="buttonBrowseSftpKey">
              <property name="text">
               <string>Browse...</string>
              </property>
             </widget>
            </item>
           </layout>
          </item>
          <item row="5" column="0">
           <widget class="QLabel" name="labelSftpPassword">
            <property name="text">
             <string>Passphrase / Password:</string>
            </property>
           </widget>
          </item>
          <item row="5" column="1">
           <widget class="QLineEdit" name="editSftpPassword">
            <property name="echoMode">
             <enum>QLineEdit::Password</enum>
            </property>
            <property name="placeholderText">
             <string>Key passphrase (or password if no key)</string>
            </property>
           </widget>
          </item>
         </layout>
        </widget>
       </item>
       <item>
        <layout class="QHBoxLayout" name="layoutTestSftp">
         <item>
          <widget class="QPushButton" name="buttonTestSftp">
           <property name="text">
            <string>Test SFTP Connection</string>
           </property>
          </widget>
         </item>
         <item>
          <widget class="QLabel" name="labelTestSftpResult">
           <property name="text">
            <string/>
           </property>
          </widget>
         </item>
        </layout>
       </item>
       <item>
        <spacer name="verticalSpacerSftp">
         <property name="orientation">
          <enum>Qt::Vertical</enum>
         </property>
         <property name="sizeHint" stdset="0">
          <size>
           <width>20</width>
           <height>40</height>
          </size>
